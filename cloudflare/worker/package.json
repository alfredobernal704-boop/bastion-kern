{
  "name": "@offentlogspot/bastion-kern-ingestion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create bastion-kern-events",
    "db:migrate:local": "wrangler d1 migrations apply bastion-kern-events --local",
    "db:migrate:remote": "wrangler d1 migrations apply bastion-kern-events --remote"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  }
}