{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:offentlogspot:bastion-kern:schema:event:1.0.0",
  "title": "BASTION-KERN canonical event",
  "description": "Canonical event interchange contract. Provider-specific fields and implementation semantics require versioned review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "domain",
    "category",
    "title",
    "verification",
    "lifecycle",
    "provenance",
    "timestamps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "domain": {
      "type": "string",
      "enum": [
        "global",
        "local"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "seismic",
        "severe_weather",
        "hydrological",
        "wildfire",
        "geological",
        "environmental",
        "infrastructure",
        "public_disruption",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "severity": {
      "type": "string",
      "enum": [
        "informational",
        "low",
        "moderate",
        "high",
        "critical",
        "unknown"
      ],
      "default": "unknown"
    },
    "verification": {
      "type": "string",
      "enum": [
        "verified",
        "corroborated",
        "preliminary",
        "unconfirmed",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "active",
        "updated",
        "resolved",
        "withdrawn",
        "unknown"
      ]
    },
    "geometry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/geometry"
        }
      ]
    },
    "location_name": {
      "type": "string",
      "maxLength": 240
    },
    "impact_geometry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/geometry"
        }
      ]
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingested_at"
      ],
      "properties": {
        "source_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_published_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "source_record_id"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "terms_url": {
          "type": "string",
          "format": "uri"
        },
        "attribution": {
          "type": "string",
          "maxLength": 1000
        },
        "source_crs": {
          "type": "string",
          "maxLength": 80
        },
        "source_axis_order": {
          "type": "string",
          "enum": [
            "longitude_latitude",
            "latitude_longitude",
            "provider_defined",
            "unknown"
          ]
        },
        "transformation_version": {
          "type": "string",
          "maxLength": 120
        },
        "raw_payload_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "availability": {
      "type": "string",
      "enum": [
        "live",
        "delayed",
        "unavailable",
        "historical",
        "unknown"
      ],
      "default": "unknown"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      },
      "maxItems": 40
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "Longitude in decimal degrees."
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "Latitude in decimal degrees."
        },
        {
          "type": "number",
          "description": "Optional ellipsoidal height in metres when supplied by the source."
        }
      ],
      "items": false,
      "description": "RFC 7946 position in [longitude, latitude, optional ellipsoidal height] order."
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "$ref": "#/$defs/position"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPoint"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/position"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/position"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiLineString"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/position"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "$ref": "#/$defs/position"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "$ref": "#/$defs/position"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
